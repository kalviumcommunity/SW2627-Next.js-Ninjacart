generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FARMER
  RETAILER
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role
  farmer    Farmer?
  retailer  Retailer?
  produces  Produce[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Farmer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("farmers")
}

model Retailer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("retailers")
}

enum ProduceStatus {
  AVAILABLE
  SOLD_OUT
}

model Produce {
  id          String        @id @default(uuid())
  name        String
  price       Float
  quantity    Int
  category    String
  image       String
  status      ProduceStatus @default(AVAILABLE)
  farmerId    String
  farmer      User          @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("produce")
}
