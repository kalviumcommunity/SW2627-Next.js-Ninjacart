# ==============================================================================
# Ninjacart Backend Environment Configuration
# ==============================================================================

# PostgreSQL Database Connection String
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?[options]
#
# Examples:
# 1. Local PostgreSQL (default port 5432):
#    DATABASE_URL="postgresql://postgres:password@localhost:5432/ninjacart?schema=public"
#
# 2. Cloud - Neon / Render / Supabase (Requires SSL):
#    DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"
#    DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/ninjacart?schema=public&connection_limit=5&pool_timeout=20"

# Authentication & JWT Configuration
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_ninjacart"
JWT_EXPIRES_IN="7d"

# Server & CORS Configuration
PORT=5000
FRONTEND_URL="http://localhost:3000"

# Cloudinary Storage Configuration (for Produce Images)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="ninjacart_preset"
