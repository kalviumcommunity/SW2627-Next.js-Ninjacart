{
  "name": "ninjacart-backend",
  "version": "1.0.0",
  "description": "Ninjacart Produce Catalogue System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node seed.js",
    "seed:bulk": "node seed.js --bulk",
    "test": "node test/verify.js && node test/order.test.js && node test/produce.test.js && node test/produce_upload.verify.js",
    "test:catalogue": "node tests/catalogue.pagination.test.js",
    "test:concurrency": "node tests/inventory.transaction.test.js",
    "test:filter": "node tests/catalogue.filter.test.js"
  },
  "prisma": {
    "seed": "node seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
